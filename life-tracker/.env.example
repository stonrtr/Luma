# ─────────────────────────────────────────────────────────────
# team M — приклад конфігурації. Скопіюйте у .env і заповніть.
# .env у .gitignore — секрети не комітяться.
# ─────────────────────────────────────────────────────────────

# --- Обов'язкове ---
# База даних. Dev: SQLite. Prod: Postgres (див. DEPLOYMENT.md).
# Локально: file:./dev.db (SQLite). В проде: postgres://USER:PASS@HOST:5432/DB
DATABASE_URL=file:./dev.db"file:./dev.db"
# Секрет для сесій NextAuth. Згенеруйте: openssl rand -base64 32
AUTH_SECRET=""
# Базовий URL застосунку (використовується в листах, OAuth, web-push)
APP_URL="http://localhost:3100"

# --- Початковий адміністратор (для сідера) ---
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# --- Планувальник (cron) ---
# Секрет для /api/cron/run. У проді обов'язковий.
CRON_SECRET=""

# --- ШІ: витяг задач із саммарі дзвінка (опційно) ---
# Пріоритет: Gemini → Anthropic → евристика. Без ключів працює евристика.
# Google Gemini (безкоштовний tier): ключ з https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# На безкоштовному ключі pro-моделі часто 429 (немає квоти) — беремо flash.
# gemini-flash-latest — стабільний аліас; резерв: gemini-3.5-flash, gemini-2.0-flash.
GEMINI_MODEL="gemini-flash-latest"
# Anthropic (альтернатива)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"

# --- Google Calendar (опційно) ---
# Google Cloud Console → OAuth client (Web) + увімкнути Calendar API.
# Redirect URI: $APP_URL/api/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Web-push (опційно) ---
# Згенеруйте пару: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# --- Telegram-бот (опційно) ---
# Створіть бота у @BotFather, візьміть токен і username бота.
# Вебхук: curl "https://api.telegram.org/bot$TOKEN/setWebhook?url=$APP_URL/api/telegram/webhook&secret_token=$TELEGRAM_WEBHOOK_SECRET"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""

# --- Пошта (опційно; без неї запрошення показують пароль на екрані) ---
# Варіант A: Resend
RESEND_API_KEY=""
# Варіант B: SMTP
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="team M <no-reply@example.com>"
